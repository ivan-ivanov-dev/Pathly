@using Pathly.ViewModels.Roadmaps
@model RoadmapPlannerViewModel

@{
    ViewData["Title"] = "Strategic Linker";
}

@section Styles {
    <link rel="stylesheet" href="~/css/taskLinking.css" asp-append-version="true" />
}

<div class="roadmap-page-bg min-vh-100 pb-5">
    <div class="container py-5">
        @* HEADER SECTION *@
        <div class="d-flex justify-content-between align-items-end mb-5 animate-fade-in">
            <div class="linker-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item">
                            <a asp-action="Details" asp-route-id="@Model.RoadmapId" class="text-primary text-decoration-none fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i>Back to Roadmap
                            </a>
                        </li>
                    </ol>
                </nav>
                <h1 class="display-5 fw-bold text-dark">Strategic Mapping</h1>
                <p class="lead text-muted mb-0">
                    Link your existing tasks to this milestone to track progress toward your goal.
                    <br class="d-none d-md-block"> <a asp-controller="Tasks" asp-action="Index" class="text-primary text-decoration-none fw-semibold hstack gap-1 mt-1">
                        <i class="bi bi-plus-circle-fill fs-6"></i>
                        <span>Create a new task to link from here</span>
                    </a>
                </p>
            </div>

            <div class="selection-status d-none d-lg-block text-end">
                <span class="badge rounded-pill bg-white border text-primary px-3 py-2 shadow-sm mb-2">
                    <span id="headerCounter">0</span> Tasks Selected
                </span>
            </div>
        </div>

        <form asp-action="SaveAssignments" method="post" id="assignmentForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="actionId" value="@Model.TargetActionId" />
            <input type="hidden" name="roadmapId" value="@Model.RoadmapId" />
            <input type="hidden" id="selectedTaskIds" name="selectedTaskIds" value="" />

            @if (Model.UnlinkedTasks == null || !Model.UnlinkedTasks.Any())
            {
                <div class="text-center py-5 border-dashed rounded-4 bg-white animate-fade-in">
                    <div class="empty-state-icon mb-4">
                        <i class="bi bi-stack display-1 text-light-blue"></i>
                    </div>
                    <h3 class="fw-bold">No tasks left behind!</h3>
                    <p class="text-muted mx-auto" style="max-width: 400px;">
                        All your tasks are currently linked, or you haven't created any yet.
                        Add a new task to your dashboard first.
                    </p>
                    <a asp-controller="Tasks" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-3">
                        Go to Tasks Dashboard
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4 animate-staggered">
                    @foreach (var task in Model.UnlinkedTasks)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 linker-card border-0 shadow-sm"
                                 id="planner-card-@task.Id"
                                 onclick="RoadmapUI.toggleLocalSelection(this, @task.Id)">

                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="task-type-pill small fw-bold text-uppercase tracking-tighter">Task</div>
                                        <div class="linker-check">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </div>
                                    </div>

                                    <h5 class="card-title fw-bold text-dark mb-2">@task.Title</h5>
                                    <p class="card-text text-muted small flex-grow-1">
                                        @(task.Description?.Length > 100 ? task.Description.Substring(0, 97) + "..." : task.Description)
                                    </p>

                                    <div class="mt-4 pt-3 border-top border-light d-flex align-items-center">
                                        <i class="bi bi-calendar3 me-2 text-primary small"></i>
                                        <span class="small fw-semibold text-muted">
                                            @(task.DueDate.HasValue? task.DueDate.Value.ToString("MMM dd, yyyy") : "No deadline set")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* STICKY SAVE BAR *@
                <div class="linker-save-bar shadow-lg animate-fade-in-up">
                    <div class="d-flex align-items-center justify-content-between container">
                        <div class="d-flex align-items-center">
                            <span class="selected-count-num me-3" id="footerCounter">0</span>
                            <span class="text-white fw-medium">Tasks ready to be linked</span>
                        </div>
                        <button type="submit" class="btn btn-light btn-lg rounded-pill px-5 fw-bold text-primary">
                            Save Mapping <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let selectedSet = new Set();

        var RoadmapUI = {
            toggleLocalSelection: function(cardElement, taskId) {
                cardElement.classList.toggle('selected');

                if (cardElement.classList.contains('selected')) {
                    selectedSet.add(taskId);
                } else {
                    selectedSet.delete(taskId);
                }

                const count = selectedSet.size;
                document.getElementById('headerCounter').innerText = count;
                document.getElementById('footerCounter').innerText = count;
                document.getElementById('selectedTaskIds').value = Array.from(selectedSet).join(',');

                // Show/Hide Save Bar
                const saveBar = document.querySelector('.linker-save-bar');
                if(count > 0) {
                    saveBar.classList.add('visible');
                } else {
                    saveBar.classList.remove('visible');
                }
            }
        };
    </script>
}