@model dynamic
@{
    int index = ViewBag.Index;
    bool isDetails = ViewBag.IsDetails ?? false;
    int? roadmapId = ViewBag.RoadmapId;

    //Find Id dynamically to support both ActionId and Id properties
    var currentId = 0;
    try { currentId = Model.ActionId; }
    catch { try { currentId = Model.Id; } catch { currentId = 0; } }
}

<div class="milestone-card-wrapper">
    <div class="action-card card h-100 shadow-sm border-0 border-top-warning border-4">
        <div class="card-body p-4 d-flex flex-column">

            @if (!isDetails)
            {
                <input type="hidden" name="Actions[@index].currentId" value="@currentId" />
            }

            @* HEADER *@
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="badge bg-soft-primary text-primary text-uppercase mb-1" style="font-size: 0.65rem;">Milestone @(index + 1)</span>
                    @if (isDetails)
                    {
                        <h5 class="fw-bold mb-0">@Model.Title</h5>
                    }
                </div>

                @if (isDetails && Model.DueDate != null)
                {
                    <span class="badge bg-light text-muted border py-2">@Model.DueDate.ToString("MMM dd")</span>
                }
                else if (!isDetails)
                {
                    <i class="bi bi-layers text-muted opacity-50"></i>
                }
            </div>

            @* EDIT MODE TITLE & DATE *@
            @if (!isDetails)
            {
                <div class="mb-3">
                    <label class="small fw-bold text-muted text-uppercase mb-1">Title</label>
                    <input name="Actions[@index].Title" value="@Model.Title" class="form-control fw-bold border-0 bg-light shadow-none" placeholder="Target outcome..." />
                </div>

                <div class="mb-3">
                    <label class="small fw-bold text-muted text-uppercase mb-1">Due Date</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-calendar-event text-primary"></i></span>
                        <input name="Actions[@index].DueDate" type="date" value="@(Model.DueDate?.ToString("yyyy-MM-dd"))" class="form-control border-0 bg-light shadow-none" />
                    </div>
                </div>
            }

            @* TASKS SECTION (Only in Details) *@
            @if (isDetails)
            {
                <div class="task-branch-section mt-2 flex-grow-1">
                    <div class="small fw-bold text-muted text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                        <i class="bi bi-list-check me-1"></i> Active Tasks
                    </div>

                    <ul class="list-unstyled mb-0">
                        @if (Model.AssignedTasks != null && Enumerable.Any(Model.AssignedTasks))
                        {
                            @foreach (var task in Model.AssignedTasks)
                            {
                                <li class="small py-2 d-flex align-items-center justify-content-between border-bottom-dashed @(task.IsCompleted ? "task-completed" : "")" id="task-item-@task.Id">
                                    <div class="d-flex align-items-center overflow-hidden me-2">
                                        <div class="form-check me-2">
                                            <input type="checkbox"
                                                   class="form-check-input task-toggle-check"
                                                   @(task.IsCompleted ? "checked" : "")
                                                   onclick="RoadmapDetails.toggleTaskStatus('@task.Id')" />
                                        </div>
                                        <span class="text-truncate task-title @(task.IsCompleted ? "text-decoration-line-through text-muted" : "")"
                                              title="@task.Title">
                                            @task.Title
                                        </span>
                                    </div>
                                    <button type="button" class="unlink-action-btn" onclick="RoadmapDetails.unlinkTask('@task.Id', '@Url.Action("UnlinkTask", "Roadmap")')">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="small text-muted fst-italic py-2 opacity-75">No tasks linked yet.</li>
                        }
                    </ul>
                </div>
            }

            @* RESOURCES SECTION *@

            @* Show resources only if id is valid *@
            @if (currentId > 0)
            {
                <div class="mt-3 pt-3 border-top">
                    <div class="small fw-bold text-muted text-uppercase mb-2" style="font-size: 0.7rem;">
                        <i class="bi bi-link-45deg me-1 text-warning"></i> Resources
                    </div>

                    <div id="resource-list-@currentId" class="mb-2">
                        @if (!string.IsNullOrEmpty(Model.Resources))
                        {
                            var files = Model.Resources.Split(';', StringSplitOptions.RemoveEmptyEntries);
                            foreach (var fileName in files)
                            {
                                var fileId = Guid.NewGuid().ToString("N");
                                <div class="resource-item d-flex align-items-center justify-content-between p-2 mb-1 rounded bg-light border shadow-sm" id="res-@fileId">
                                    <a href="@Url.Action("DownloadResource", "Roadmap", new { blobName = fileName })"
                                       target="_blank" class="text-truncate small text-decoration-none text-dark me-2">
                                        <i class="bi bi-file-earmark-pdf text-danger me-1"></i> @fileName.Substring(fileName.IndexOf('_') + 1)
                                    </a>
                                    <button type="button" class="btn btn-xs btn-outline-danger border-0 p-0 px-1"
                                            onclick="RoadmapResources.deleteResource('@currentId', '@fileName', 'res-@fileId')">
                                        <i class="bi bi-dash-square"></i>
                                    </button>
                                </div>
                            }
                        }
                    </div>

                    <div class="drop-zone mt-2" id="drop-zone-@currentId" onclick="document.getElementById('file-input-@currentId').click()">
                        <span class="drop-zone__prompt">Drop file here or click to upload</span>
                        <input type="file" id="file-input-@currentId" class="drop-zone__input" 
                               onchange="RoadmapResources.uploadFile('@currentId', this.files[0])"
                               style="display:none;">

                        <div class="progress mt-2 d-none" style="height: 5px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-light small fst-italic mt-3">
                    <i class="bi bi-info-circle me-1"></i> Save the strategy first to enable resource uploads.
                </div>
            }

            @* BUTTONS (Only in Details) *@
            @if (isDetails)
            {
                <div class="d-flex gap-2 mt-4 pt-2">
                    <a asp-action="Planner" asp-route-actionId="@currentId" asp-route-roadmapId="@roadmapId"
                       class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-pill">
                        <i class="bi bi-link-45deg me-1"></i> Connect Tasks
                    </a>
                </div>
            }
        </div>
    </div>
</div>