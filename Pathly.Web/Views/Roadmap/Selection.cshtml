@using Pathly.DataModels
@model IEnumerable<Goal>

<div class="container-fluid mt-5">
    <div class="text-center mb-5">
        <h2 class="display-6">Start Your Journey</h2>
        <p class="text-muted">Choose how you want to build your new roadmap.</p>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body text-center d-flex flex-column">
                    <div class="mb-3">
                        <i class="bi bi-plus-circle text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="card-title">Brand New Goal</h4>
                    <p class="card-text text-muted">Start from scratch. We'll create a new goal and a roadmap for it at the same time.</p>
                    <div class="mt-auto">
                        <a asp-controller="Roadmap" asp-action="Create" class="btn btn-primary w-100">
                            Create Blank Roadmap
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center d-flex flex-column">
                    <div class="mb-3">
                        <i class="bi bi-list-check text-success" style="font-size: 3rem;"></i>
                    </div>
                    <h4 class="card-title">Existing Goal</h4>
                    <p class="card-text text-muted">Select one of your current goals to build a strategic plan for it.</p>
                    <div class="mt-auto">
                        <button type="button" class="btn btn-outline-success w-100" data-bs-toggle="modal" data-bs-target="#goalPickerModal">
                            Choose Existing Goal
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="goalPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <div class="ps-2 pt-2">
                    <h5 class="modal-title fw-bold">Select a Goal</h5>
                    <p class="text-muted small mb-0">Which goal needs a strategic roadmap?</p>
                </div>
                <button type="button" class="btn-close me-2 mt-2" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                @if (!Model.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-clipboard-x text-muted" style="font-size: 3rem;"></i>
                        <p class="mt-3 text-muted">You have no active goals without roadmaps.</p>
                        <a asp-controller="Goal" asp-action="Create" class="btn btn-sm btn-primary rounded-pill mt-2">Create a Goal First</a>
                    </div>
                }
                else
                {
                    <div class="goal-list-container custom-scrollbar" style="max-height: 400px; overflow-y: auto;">
                        @foreach (var goal in Model)
                        {
                            <a asp-controller="Roadmap" asp-action="Create" asp-route-goalId="@goal.Id"
                               class="goal-select-item d-flex align-items-center p-3 mb-2 text-decoration-none">
                                <div class="goal-mini-icon me-3">
                                    <i class="bi bi-bullseye text-primary"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-0 fw-bold text-dark">@goal.Title</h6>
                                    <small class="text-muted">Click to select this goal</small>
                                </div>
                                <i class="bi bi-chevron-right text-muted"></i>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>