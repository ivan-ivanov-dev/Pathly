@{
    ViewData["Title"] = "Server Error";
    Layout = "_Layout";
}

<div class="container text-center py-5 animate-fade-in">
    <div class="py-5">
        <h1 class="display-1 fw-bold text-danger">500</h1>
        <div class="mb-4">
            <i class="bi bi-gear-wide-connected text-muted opacity-25" style="font-size: 5rem;"></i>
        </div>
        <h2 class="fw-bold text-dark">Something went wrong on our end</h2>
        <p class="text-muted mx-auto mb-5" style="max-width: 500px;">
            Don't worry, our team of developers has been notified. We are working to get the path cleared for you.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm">
            Try Refreshing
        </a>
    </div>
</div>