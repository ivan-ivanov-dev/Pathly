@{
    ViewData["Title"] = "Page Not Found";
    Layout = "_Layout";
}

<div class="container text-center py-5 animate-fade-in">
    <div class="py-5">
        <h1 class="display-1 fw-bold text-primary">404</h1>
        <div class="mb-4">
            <i class="bi bi-map text-muted opacity-25" style="font-size: 5rem;"></i>
        </div>
        <h2 class="fw-bold text-dark">You've wandered off the path</h2>
        <p class="text-muted mx-auto mb-5" style="max-width: 500px;">
            The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                Back to Home
            </a>
            <button onclick="history.back()" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                Go Back
            </button>
        </div>
    </div>
</div>