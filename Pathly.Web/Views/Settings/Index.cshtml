@model Pathly.ViewModels.Settings.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="container-fluid py-4 animate-fade-in">
    <div class="settings-header mb-4 shadow-sm p-4 bg-white rounded-5">
        <h1 class="fw-850 text-dark mb-1">Account Settings</h1>
        <p class="text-muted">Manage your identity and privacy in Pathly.</p>
    </div>

    <div class="accordion border-0 shadow-sm rounded-5 overflow-hidden" id="settingsAccordion">

        <div class="accordion-item border-0">
            <h2 class="accordion-header">
                <button class="accordion-button fw-bold py-4 px-4" type="button" data-bs-toggle="collapse" data-bs-target="#collapseProfile">
                    <i class="bi bi-person-circle me-3 text-primary"></i> Profile Details
                </button>
            </h2>
            <div id="collapseProfile" class="accordion-collapse collapse show" data-bs-parent="#settingsAccordion">
                <div class="accordion-body p-4 bg-white">
                    <form asp-action="UpdateProfile" method="post" class="col-lg-6">
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold small text-uppercase">Username</label>
                            <input asp-for="Username" class="form-control rounded-4 p-3 border-light bg-light shadow-none" />
                        </div>
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-bold small text-uppercase">Email Address</label>
                            <input asp-for="Email" class="form-control rounded-4 p-3 border-light bg-light shadow-none" />
                        </div>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Save Profile</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="accordion-item border-0 border-top">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fw-bold py-4 px-4" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSecurity">
                    <i class="bi bi-shield-lock me-3 text-primary"></i> Security & Password
                </button>
            </h2>
            <div id="collapseSecurity" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
                <div class="accordion-body p-4 bg-white">
                    <form asp-action="ChangePassword" method="post" class="col-lg-6">
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-bold small text-uppercase">Current Password</label>
                            <input asp-for="CurrentPassword" type="password" class="form-control rounded-4 p-3 border-light bg-light shadow-none" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold small text-uppercase">New Password</label>
                            <input asp-for="NewPassword" type="password" class="form-control rounded-4 p-3 border-light bg-light shadow-none" />
                        </div>
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold small text-uppercase">Confirm Password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control rounded-4 p-3 border-light bg-light shadow-none" />
                        </div>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Update Password</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="accordion-item border-0 border-top">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed fw-bold py-4 px-4 text-danger" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDanger">
                    <i class="bi bi-exclamation-triangle me-3"></i> Danger Zone
                </button>
            </h2>
            <div id="collapseDanger" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
                <div class="accordion-body p-4 bg-white">
                    <div class="d-flex flex-column gap-4">
                        <div class="p-3 rounded-4 bg-light border border-light">
                            <h6 class="fw-bold mb-2">Logout</h6>
                            <p class="text-muted small">Ready to take a break? Securely sign out of your session.</p>
                            <form asp-area="Identity" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-dark rounded-pill px-4 fw-bold shadow-sm">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </button>
                            </form>
                        </div>

                        <div class="p-3 rounded-4 bg-soft-danger border border-light">
                            <h6 class="fw-bold text-danger mb-2">Permanently Delete Account</h6>
                            <p class="text-muted small">This action is irreversible. All your data will be wiped.</p>
                            <form id="deleteUserForm" asp-action="DeleteAccount" method="post" style="display:none;">
                                @Html.AntiForgeryToken()
                            </form>
                            <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" onclick="confirmAccountDelete()">
                                <i class="bi bi-trash3 me-2"></i>Delete My Account
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmAccountDelete() {
            Swal.fire({
                title: 'Are you absolutely sure?',
                text: "Pathly will permanently erase all your goals and roadmaps!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete everything!',
                borderRadius: '24px'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteUserForm').submit();
                }
            });
        }
    </script>
}