@using Pathly.DataModels
@using Pathly.ViewModels.TasksViewModels
@model TaskListViewModel

@{
    ViewData["Title"] = "Strategic Board";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/tasks.css" asp-append-version="true" />
}

<div class="container py-5 animate-fade-in">
    @* --- 1. STRATEGIC HEADER --- *@
    <div class="tasks-header mb-5">
        <div>
            <h2 class="tracking-tight mb-1">Execution Pipeline</h2>
            <p class="text-muted fw-semibold small text-uppercase letter-spacing-1">
                Strategic Overview & Task Management
            </p>
        </div>
        <div class="d-flex gap-3">
            <div class="d-none d-md-flex align-items-center me-3 border-end pe-4">
                <div class="text-end me-3">
                    <div class="small text-muted fw-bold text-uppercase" style="font-size: 0.6rem;">Total Output</div>
                    <div class="fw-800 text-dark">@Model.Tasks.Count() Tasks</div>
                </div>
                <div class="text-end">
                    <div class="small text-muted fw-bold text-uppercase" style="font-size: 0.6rem;">Completion</div>
                    <div class="fw-800 text-success">
                        @{
                            var total = Model.Tasks.Count();
                            var done = Model.Tasks.Count(t => t.Status == Pathly.DataModels.TaskStatus.Done);
                            var percent = total > 0 ? (done * 100) / total : 0;
                        }
                        @percent%
                    </div>
                </div>
            </div>
            <button class="btn btn-dark rounded-3 px-4 shadow-sm fw-bold d-flex align-items-center"
                    data-modal-url="@Url.Action("Create", "Tasks")" data-modal-title="Create Strategic Task">
                <i class="bi bi-plus-lg me-2"></i> NEW INITIATIVE
            </button>
        </div>
    </div>

    @* --- 2. ENHANCED FILTER SYSTEM --- *@
    <div class="card filter-card mb-5 shadow-sm border-0">
        <div class="card-body p-3">
            <form method="get" id="filterForm" class="row g-3 align-items-center">
                <div class="col-lg-4 col-md-12">
                    <div class="input-group bg-light-subtle rounded-3 px-2 border">
                        <span class="input-group-text bg-transparent border-0 pe-2 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="SearchByTitle"
                               class="form-control border-0 bg-transparent shadow-none py-2 fw-semibold"
                               placeholder="Search initiatives..."
                               value="@Context.Request.Query["SearchByTitle"]" />
                    </div>
                </div>

                <div class="col-lg-2 col-md-3">
                    <div class="uppercase-label mb-1 ms-1">Priority</div>
                    <select name="Priority" class="form-select form-select-sm border-0 bg-light-subtle fw-bold text-muted py-2">
                        <option value="">All Levels</option>
                        @foreach (var p in Enum.GetValues<TaskPriority>())
                        {
                            <option value="@((int)p)" selected="@(Context.Request.Query["Priority"] == ((int)p).ToString())">@p</option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-3">
                    <div class="uppercase-label mb-1 ms-1">Categorization</div>
                    <select name="SelectedTagIds" class="form-select form-select-sm border-0 bg-light-subtle fw-bold text-muted py-2">
                        <option value="">All Tags</option>
                        @foreach (var tag in Model.AvailableFilterTags)
                        {
                            <option value="@tag.Id" selected="@(Context.Request.Query["SelectedTagIds"].Contains(tag.Id.ToString()))">
                                #@tag.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-3">
                    <div class="uppercase-label mb-1 ms-1">Deadline</div>
                    <input type="date" name="DueDate"
                           class="form-control form-control-sm border-0 bg-light-subtle fw-bold text-muted py-2"
                           value="@Context.Request.Query["DueDate"]" />
                </div>

                <div class="col-lg-2 col-md-3 mt-lg-4">
                    <button type="submit" class="btn btn-primary w-100 rounded-3 fw-800 shadow-sm py-2">
                        REFINE VIEW
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* --- 3. KANBAN ARCHITECTURE --- *@
    <div class="row g-4 d-flex align-items-stretch">
        @foreach (var status in new[] {
                new { Title = "Pending Execution", ID = 1, Icon = "bi-list-ul", Color = "#6c757d", Enum = Pathly.DataModels.TaskStatus.Todo },
                new { Title = "Active Development", ID = 2, Icon = "bi-lightning-charge", Color = "#0d6efd", Enum = Pathly.DataModels.TaskStatus.InProgress },
                new { Title = "Finalized", ID = 3, Icon = "bi-check2-all", Color = "#198754", Enum = Pathly.DataModels.TaskStatus.Done }
                })
        {
            <div class="col-xl-4 col-md-12 d-flex">
                <div class="kanban-column shadow-sm border-dashed d-flex flex-column w-100" data-status-group="@status.ID">

                    @* Column Header *@
                    <div class="d-flex justify-content-between align-items-center mb-4 px-1">
                        <div class="d-flex align-items-center">
                            <div class="rounded-3 p-2 d-flex align-items-center justify-content-center me-2"
                                 style="background-color:rgba(0,0,0,0.05);width:32px;height:32px;">
                                <i class="bi @status.Icon" style="color:@status.Color;"></i>
                            </div>
                            <h6 class="kanban-column-title mb-0">@status.Title</h6>
                        </div>
                        <span class="column-count-badge rounded-pill">
                            @Model.Tasks.Count(t => t.Status == status.Enum)
                        </span>
                    </div>

                    @* Column Body *@
                    <div class="kanban-column-body py-1 d-flex flex-column flex-grow-1"
                         data-status="@((int)status.Enum)"
                         style="min-height:80vh;transition:background-color 0.2s ease;">

                        @foreach (var task in Model.Tasks.Where(t => t.Status == status.Enum))
                        {
                            <partial name="_TaskCardPartial" model="task" />
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* --- 4. MODAL FRAMEWORK --- *@
@* --- 4. MODAL FRAMEWORK (Cleaned) --- *@
<div class="modal fade" id="taskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content overflow-hidden border-0 shadow-lg bg-transparent">
            <div id="taskModalBody">
                @* Partial content (with its own header) injects here *@
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/tasks.js" asp-append-version="true"></script>
}