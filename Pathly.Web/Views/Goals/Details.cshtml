@using Pathly.ViewModels.Goals
@model GoalDetailsViewModel

@{
    ViewData["Title"] = "Goal Details";
}

@section Styles {
    <link rel="stylesheet" href="~/css/goals.css" asp-append-version="true" />
}

<div class="goal-page-wrapper py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 animate-fade-in">
                
                @* Back Link *@
                <nav aria-label="breadcrumb" class="mb-4">
                    <a asp-action="Index" class="text-decoration-none text-muted small fw-bold">
                        <i class="bi bi-arrow-left me-1"></i> Back to Strategic Goals
                    </a>
                </nav>

                <div class="card glass-card border-0 rounded-4 overflow-hidden">
                    
                    <div class="goal-form-header text-center position-relative">
                        <div class="goal-icon-box bg-white bg-opacity-10 mx-auto mb-3">
                            <i class="bi bi-eye fs-3"></i>
                        </div>
                        <h3 class="fw-bold mb-2">Goal Overview</h3>
                        <div class="d-flex justify-content-center">
                             <span class="badge @(Model.IsActive ? "bg-soft-success text-white border border-white border-opacity-25" : "bg-secondary text-white") rounded-pill px-3">
                                <i class="bi @(Model.IsActive ? "bi-lightning-charge-fill" : "bi-check-circle-fill") me-1"></i>
                                @(Model.IsActive ? "Currently Active" : "Goal Achieved")
                            </span>
                        </div>
                        
                        @* Floating Edit Button in Header *@
                        <a asp-action="Edit" asp-route-id="@Model.Id" 
                           class="btn btn-sm btn-light rounded-pill px-3 position-absolute top-0 end-0 m-4 shadow-sm fw-bold">
                            <i class="bi bi-pencil me-1" style="color: #000 !important;"></i> Edit
                        </a>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-5">
                            <h1 class="fw-bold text-dark display-6 mb-3">@Model.Title</h1>
                            <p class="lead text-muted mx-auto" style="max-width: 600px;">
                                @(string.IsNullOrEmpty(Model.ShortDescription) ? "No description provided for this goal." : Model.ShortDescription)
                            </p>
                        </div>

                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <div class="p-4 bg-light bg-opacity-50 rounded-4 border border-white shadow-sm h-100">
                                    <p class="info-label mb-2 text-primary">Target Completion</p>
                                    <h5 class="fw-bold mb-0 text-dark">
                                        <i class="bi bi-calendar-check me-2"></i>
                                        @(Model.TargetDate.HasValue ? Model.TargetDate.Value.ToString("MMMM dd, yyyy") : "No deadline set")
                                    </h5>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-4 bg-light bg-opacity-50 rounded-4 border border-white shadow-sm h-100">
                                    <p class="info-label mb-2 text-primary">Strategic Focus</p>
                                    <h5 class="fw-bold mb-0 text-dark">
                                        @if (Model.IsActive)
                                        {
                                            <i class="bi bi-arrow-up-right-circle me-2 text-success"></i> <span>In Progress</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-all me-2 text-muted"></i> <span>Completed</span>
                                        }
                                    </h5>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-top border-light text-center">
                            @if (Model.RoadmapId.HasValue)
                            {
                                <p class="small text-muted mb-3">A roadmap strategy is already active for this goal.</p>
                                <a asp-controller="Roadmap" asp-action="Details" asp-route-id="@Model.RoadmapId" 
                                   class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm py-3">
                                    <i class="bi bi-map-fill me-2"></i>Navigate Roadmap
                                </a>
                            }
                            else
                            {
                                <p class="small text-muted mb-3">Ready to break this goal down into steps?</p>
                                <a asp-controller="Roadmap" asp-action="Create" asp-route-goalId="@Model.Id" 
                                   class="btn btn-outline-primary btn-lg rounded-pill px-5 fw-bold shadow-sm py-3">
                                    <i class="bi bi-plus-circle-dotted me-2"></i>Design Roadmap
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>