@using Pathly.ViewModels.Goals
@model GoalQueryModel

@{
    ViewData["Title"] = "My Goals";
}

@section Styles {
    <link rel="stylesheet" href="~/css/goals.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    @* Header *@
    <div class="d-flex justify-content-between align-items-center mb-5 animate-fade-in">
        <div>
            <h2 class="fw-bold text-dark mb-1">Strategic Goals</h2>
            <p class="text-muted small mb-0">Define your North Star and track your long-term progress</p>
        </div>

        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
            <i class="bi bi-plus-lg me-2"></i>New Goal
        </a>
    </div>

    @* Enhanced Filter Bar *@
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-3">
            <form method="get" class="row g-3 align-items-end">
                @* Search Term *@
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-muted ps-2">Search</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="SearchTerm" class="form-control border-0 bg-light shadow-none"
                               value="@Model.SearchTerm" placeholder="Goal title..." />
                    </div>
                </div>

                @* Status Filter *@
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted ps-2">Status</label>
                    <select name="ShowCompleted" class="form-select form-select-sm border-0 bg-light shadow-none">
                        <option value="">All Statuses</option>
                        <option value="true" selected="@(Context.Request.Query["ShowCompleted"] == "true")">Active</option>
                        <option value="false" selected="@(Context.Request.Query["ShowCompleted"] == "false")">Completed</option>
                    </select>
                </div>

                @* Due Date Filter *@
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted ps-2">Target Date</label>
                    <input type="date" name="TargetDate" class="form-control form-control-sm border-0 bg-light shadow-none"
                           value="@Context.Request.Query["TargetDate"]" />
                </div>

                @* Submit Button *@
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark btn-sm w-100 rounded-pill fw-bold py-2 shadow-sm">
                        <i class="bi bi-filter me-2"></i>Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    @* Goals Grid *@
    <div class="row g-4">
        @* Pagination Control *@
        @if (Model.Goals.Goals.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-5 animate-fade-in">
                <nav aria-label="Goal pagination">
                    <ul class="pagination pagination-animated">
                        @* Previous Page *@
                        <li class="page-item @(!Model.Goals.Goals.HasPrevious ? "disabled" : "")">
                            <a class="page-link border-0 shadow-sm rounded-circle mx-1"
                               asp-action="Index"
                               asp-all-route-data="@GetPaginationRoutes(Model.Goals.Goals.CurrentPage - 1)"
                               aria-label="Previous">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @* Page Number *@
                        @for (int i = 1; i <= Model.Goals.Goals.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Goals.Goals.CurrentPage ? "active" : "")">
                                <a class="page-link border-0 shadow-sm rounded-circle mx-1"
                                   asp-action="Index"
                                   asp-all-route-data="@GetPaginationRoutes(i)">@i</a>
                            </li>
                        }

                        @* Next Page *@
                        <li class="page-item @(!Model.Goals.Goals.HasNext ? "disabled" : "")">
                            <a class="page-link border-0 shadow-sm rounded-circle mx-1"
                               asp-action="Index"
                               asp-all-route-data="@GetPaginationRoutes(Model.Goals.Goals.CurrentPage + 1)"
                               aria-label="Next">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }

        @functions {
            Dictionary<string, string> GetPaginationRoutes(int page)
            {
                var routes = new Dictionary<string, string> { { "PageNumber", page.ToString() } };

                foreach (var key in Context.Request.Query.Keys)
                {
                    if (key != "PageNumber")
                    {
                        routes[key] = Context.Request.Query[key]!;
                    }
                }
                return routes;
            }
        }
        @* Goals List Layout *@
        <div class="row g-4">
            @if (Model.Goals != null && Model.Goals.Goals.Any())
            {
                @foreach (var goal in Model.Goals.Goals)
                {
                    @* We change col-lg-4 to col-12 for the Row layout *@
                    <div class="col-12">
                        <div class="card border-0 shadow-sm rounded-4 goal-row-card animate-fade-in @(!goal.IsActive ? "goal-completed" : "")">
                            <div class="card-body p-4">
                                <div class="row align-items-center">

                                    @* 1. Info Section *@
                                    <div class="col-lg-4 mb-3 mb-lg-0">
                                        <div class="d-flex align-items-center">
                                            <div class="goal-icon-box me-3">
                                                <i class="bi bi-bullseye fs-4 text-primary"></i>
                                            </div>
                                            <div>
                                                <h5 class="fw-bold text-dark mb-1">@goal.Title</h5>
                                                <p class="text-muted small mb-0 text-truncate-2">
                                                    @(string.IsNullOrEmpty(goal.ShortDescription) ? "Set your path and start moving." : goal.ShortDescription)
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    @* 2. Progress Section (The Heart of the Row) *@
                                    <div class="col-lg-4 mb-3 mb-lg-0">
                                        <div class="px-lg-4">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="small fw-bold text-muted">Progress</span>
                                                <span class="small fw-800 text-primary">@goal.ProgressPercentage%</span>
                                            </div>
                                            <div class="progress rounded-pill" style="height: 8px; background-color: rgba(15, 76, 92, 0.1);">
                                                <div class="progress-bar progress-bar-striped progress-bar-animated rounded-pill"
                                                     role="progressbar"
                                                     style="width: @goal.ProgressPercentage%; background-color: var(--pathly-primary);">
                                                </div>
                                            </div>
                                            <div class="mt-2 d-flex gap-3">
                                                <span class="badge bg-soft-info text-info rounded-pill" style="font-size: 0.65rem;">
                                                    <i class="bi bi-check2-circle me-1"></i> @goal.CompletedTasksCount Tasks Done
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    @* 3. Metadata & Actions *@
                                    <div class="col-lg-4">
                                        <div class="d-flex align-items-center justify-content-lg-end gap-3">
                                            @if (goal.TargetDate.HasValue)
                                            {
                                                <div class="text-end d-none d-xl-block me-2">
                                                    <div class="info-label mb-0" style="font-size: 0.6rem;">Deadline</div>
                                                    <div class="small fw-bold text-dark">@goal.TargetDate.Value.ToString("MMM dd, yyyy")</div>
                                                </div>
                                            }

                                            <div class="d-flex gap-2">
                                                @if (goal.HasRoadmap)
                                                {
                                                    <a asp-controller="Roadmap" asp-action="Details" asp-route-id="@goal.RoadmapId"
                                                       class="btn btn-soft-primary rounded-pill px-3 fw-bold btn-sm">
                                                        <i class="bi bi-map me-1"></i> Roadmap
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-controller="Roadmap" asp-action="Create" asp-route-goalId="@goal.Id"
                                                       class="btn btn-outline-primary rounded-pill px-3 fw-bold btn-sm">
                                                        <i class="bi bi-plus-lg me-1"></i> Roadmap
                                                    </a>
                                                }

                                                @* Status Toggle *@
                                                <form asp-action="ToggleStatus" asp-route-id="@goal.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm @(goal.IsActive ? "btn-soft-success" : "btn-success") rounded-pill px-3 fw-bold">
                                                        <i class="bi @(goal.IsActive ? "bi-circle" : "bi-check-circle-fill") me-1"></i>
                                                        @(goal.IsActive ? "Active" : "Done")
                                                    </button>
                                                </form>

                                                @* Dropdown *@
                                                <div class="dropdown">
                                                    <button class="btn btn-light btn-sm rounded-circle shadow-none" data-bs-toggle="dropdown">
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                                        <li><a class="dropdown-item small" asp-action="Edit" asp-route-id="@goal.Id"><i class="bi bi-pencil me-2"></i>Edit</a></li>
                                                        <li><a class="dropdown-item small text-info" asp-action="Details" asp-route-id="@goal.Id"><i class="bi bi-info-circle me-2"></i>Details</a></li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <form asp-action="Delete" asp-route-id="@goal.Id" method="post" onsubmit="return confirm('Archive this goal?');">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="dropdown-item small text-danger"><i class="bi bi-trash me-2"></i>Delete</button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div> @* End Row *@
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                @* Empty State (No changes needed) *@
                <div class="col-12 text-center py-5">
                    <i class="bi bi-trophy display-1 text-muted opacity-25 mb-4"></i>
                    <h3 class="fw-bold text-dark">No goals found</h3>
                    <p class="text-muted">Every achievement starts with the decision to try.</p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Define a Goal</a>
                </div>
            }
        </div>
</div>