@{
    ViewData["Title"] = "Admin Overview";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Administrative Dashboard</h1>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <i class="bi bi-people text-primary display-4 mb-3"></i>
                <h5 class="card-title">User Management</h5>
                <p class="card-text text-muted">View and manage all registered accounts.</p>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Users class="btn btn-primary rounded-pill px-4">
                    Enter
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 text-center">
                <i class="bi bi-graph-up text-success display-4 mb-3"></i>
                <h5 class="card-title">System Stats</h5>
                <p class="card-text text-muted">Monitor goals and task completion rates.</p>
                <a href="#" class="btn btn-outline-success rounded-pill px-4">View Analytics</a>
            </div>
        </div>
    </div>
</div>